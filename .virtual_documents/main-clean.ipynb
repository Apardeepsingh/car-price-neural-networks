cars_model = CarsRegModel(input_size)


summary(cars_model,
        input_size=(100, input_size),
        col_names=['input_size', 'output_size', 'num_params'])


# Wrap our model in SimpleModule.regression 
cars_module = SimpleModule.regression(cars_model)

